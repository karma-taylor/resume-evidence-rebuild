{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resume JD Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_role", "jd_text_sha256", "requirements"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "target_role": {"type": "string", "minLength": 1},
    "jd_text_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "max_projects": {"enum": [3, 4], "default": 3, "description": "Use 3 by default; request 4 only after content-budget review."},
    "requirements": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "text", "keywords", "priority"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "keywords": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "priority": {"enum": ["required", "preferred"]}
        }
      }
    }
  }
}
