{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resume Role Template",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "target_role", "market", "layout"],
  "properties": {
    "id": {"type": "string"}, "target_role": {"type": "string"}, "market": {"enum": ["CN", "NA", "FOREIGN"]},
    "project_ids": {"type": "array", "minItems": 3, "maxItems": 4, "uniqueItems": true, "items": {"type": "string"}, "description": "Legacy fixed selection. Omit only when a validated JD brief and evidence map will select 3-4 projects."},
    "layout": {"type": "object", "required": ["page", "columns", "min_body_pt", "body_line_height_multiplier"], "properties": {"page": {"const": "A4"}, "columns": {"const": 1}, "min_body_pt": {"type": "number", "minimum": 10}, "body_line_height_multiplier": {"const": 1.4}}},
    "technical_skills": {"type": "string", "description": "One compact, evidence-backed skills paragraph; no invented technologies."},
    "summary": {"type": "string", "description": "Legacy alias for technical_skills."},
    "summary_bold_phrases": {"type": "array", "items": {"type": "string"}},
    "sections": {"const": ["profile", "technical-skills", "employment", "projects", "education-certifications"]}
  }
}
