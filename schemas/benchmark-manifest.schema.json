{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private Benchmark Fixture Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "origin",
    "authorized",
    "coverage",
    "sources",
    "sentinels",
    "redaction_method",
    "created_at",
    "files"
  ],
  "properties": {
    "fixture_id": {
      "type": "string",
      "pattern": "^fixture-(0[1-9]|[1-4][0-9]|50)$"
    },
    "origin": {"const": "human_redacted"},
    "authorized": {"const": true},
    "coverage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "cn_ai_normal_density",
          "sparse_whitespace_risk",
          "dense_overflow_risk",
          "facts_without_metrics",
          "missing_project_evidence",
          "na_foreign_no_photo",
          "timeline_contact_integrity",
          "adversarial_jd"
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "sentinels": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "redaction_method": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  }
}
