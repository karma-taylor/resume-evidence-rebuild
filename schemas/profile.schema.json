{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private Resume Profile",
  "type": "object",
  "required": ["identity", "education", "employment", "projects"],
  "properties": {
    "identity": {"type": "object", "required": ["name", "phone", "email", "portfolio_url"], "properties": {"name": {"type": "string"}, "phone": {"type": "string"}, "email": {"type": "string", "format": "email"}, "portfolio_url": {"type": "string", "format": "uri"}, "photo_path": {"type": "string"}, "location": {"type": "string"}, "market": {"enum": ["CN", "NA", "FOREIGN"]}}},
    "education": {"type": "array", "items": {"type": "object", "required": ["school", "degree", "major", "start", "end"], "properties": {"school": {"type": "string"}, "degree": {"type": "string"}, "major": {"type": "string"}, "start": {"type": "string"}, "end": {"type": "string"}}}},
    "employment": {"type": "array", "items": {"type": "object", "required": ["employer", "title", "start", "end"], "properties": {"employer": {"type": "string"}, "title": {"type": "string"}, "start": {"type": "string"}, "end": {"type": "string"}, "summary": {"type": "string"}}}},
    "certifications": {"type": "array", "items": {"type": "string"}},
    "projects": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["id", "title", "start", "end", "claims"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "title": {"type": "string"}, "start": {"type": "string"}, "end": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}, "claims": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["id", "text", "source", "scope", "confidence", "allowed_for_resume"], "properties": {"id": {"type": "string"}, "text": {"type": "string"}, "source": {"type": "string"}, "scope": {"type": "string"}, "confidence": {"enum": ["verified", "bounded"]}, "allowed_for_resume": {"type": "boolean"}, "kind": {"enum": ["context", "architecture", "control", "metric", "delivery"]}}}}}}}}
  }
}
