{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private Resume Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "education", "employment", "projects"],
  "properties": {
    "identity": {"type": "object", "required": ["name", "phone", "email", "portfolio_url"], "properties": {"name": {"type": "string"}, "phone": {"type": "string"}, "email": {"type": "string", "format": "email"}, "portfolio_url": {"type": "string", "format": "uri"}, "photo_path": {"type": "string"}, "location": {"type": "string"}, "market": {"enum": ["CN", "NA", "FOREIGN"]}}},
    "education": {"type": "array", "items": {"type": "object", "required": ["school", "degree", "major", "start", "end"]}},
    "employment": {"type": "array", "items": {"type": "object", "required": ["employer", "title", "start", "end", "highlights"], "properties": {"summary": {"type": "string", "description": "Legacy source context only; it is never expanded or rendered as a work bullet."}, "highlights": {"type": "array", "minItems": 4, "maxItems": 5, "uniqueItems": true, "description": "Approved, hash-bound source facts only. Each is 25-35 CJK characters; Agent B may re-compose their verbatim fragments into 40-50 CJK business bullets, but may not invent facts.", "items": {"type": "object", "required": ["text", "source_ingestion_id", "approved_at", "source_hash"], "properties": {"text": {"type": "string", "minLength": 1}, "source_ingestion_id": {"type": "string", "minLength": 1}, "approved_at": {"type": "string", "minLength": 1}, "source_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}}}}}},
    "certifications": {"type": "array", "items": {"type": "string"}},
    "projects": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["id", "title", "start", "end", "claims"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "claims": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["id", "text", "source", "scope", "confidence", "allowed_for_resume", "kind"], "properties": {"id": {"type": "string"}, "text": {"type": "string"}, "source": {"type": "string"}, "scope": {"type": "string"}, "confidence": {"enum": ["verified", "bounded"]}, "allowed_for_resume": {"type": "boolean"}, "kind": {"enum": ["context", "architecture", "control", "metric", "delivery"]}}}}}}}
  }
}
