{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JD Local Project Evidence Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "jd_text_sha256", "matches"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "jd_text_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "matches": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["project_id", "requirement_id", "path", "line_start", "line_end", "source_sha256", "excerpt", "matched_keywords"],
        "properties": {
          "project_id": {"type": "string", "minLength": 1},
          "requirement_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "line_start": {"type": "integer", "minimum": 1},
          "line_end": {"type": "integer", "minimum": 1},
          "source_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "excerpt": {"type": "string", "minLength": 1},
          "matched_keywords": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
